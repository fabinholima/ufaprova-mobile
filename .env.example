# Copie para .env.local (desenvolvimento) — não versionado.
# Produção é configurada nas variáveis do site estático (render.yaml).
EXPO_PUBLIC_API_URL=http://localhost:8788
EXPO_PUBLIC_PORTAL_URL=http://localhost:3000
# Sem subdomínios locais, a entrada é escolhida por ?perfil=professor|aluno.
EXPO_PUBLIC_TEACHER_URL=http://localhost:8081/?perfil=professor
EXPO_PUBLIC_STUDENT_URL=http://localhost:8081/?perfil=aluno
