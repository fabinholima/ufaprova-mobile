{
  "expo": {
    "name": "UFA Prova",
    "slug": "ufaprova",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ufaprova",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o UFA Prova use a câmera para ler convites de turma e fotografar folhas de respostas.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o UFA Prova abra fotos de folhas de respostas da galeria.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.ufaprova.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "UFA Prova",
      "shortName": "UFA Prova",
      "lang": "pt-BR",
      "themeColor": "#1d4ed8",
      "backgroundColor": "#f8fafc",
      "favicon": "./public/favicon.png"
    }
  }
}
